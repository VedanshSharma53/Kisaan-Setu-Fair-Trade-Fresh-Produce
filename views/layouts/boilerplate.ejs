<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Join Kisaan Setu for better India!"
    />
    <title>
      KisaanSeva-Fair Trade,Fresh Produce
    </title>
    <link rel="shortcut icon" href="/icon/favicon.svg" type="image/x-icon" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
      integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
      media="print"
      onload="this.media='all'"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/rating.css" />
    <!-- Mapbox CSS and JS -->
    <link
      href="https://api.mapbox.com/mapbox-gl-js/v2.14.1/mapbox-gl.css"
      rel="stylesheet"
    />
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.14.1/mapbox-gl.js"></script>
  </head>

  <body>
    <div class="pageblur">
      <%- include("../includes/navbar.ejs") %>
      <div class="container">
        <%- include("../includes/flash.ejs") %> <%- body %>
      </div>

      <%- include("../includes/footer.ejs") %>
    </div>

    <!-- Removed problematic loader -->

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
      crossorigin="anonymous"
    ></script>
    <script src="/js/script.js"></script>
    <script src="/js/map.js"></script>
    
    <!-- Performance optimization script -->
    <script>
      // Optimize page performance
      document.addEventListener('DOMContentLoaded', function() {
        // Preload critical resources
        const criticalImages = document.querySelectorAll('img[data-src]');
        criticalImages.forEach(img => {
          if (img.dataset.src) {
            img.src = img.dataset.src;
          }
        });
        
        // Optimize form submissions
        const forms = document.querySelectorAll('form');
        forms.forEach(form => {
          form.addEventListener('submit', function() {
            // Show minimal loading indicator only for form submissions
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) {
              const originalText = submitBtn.innerHTML;
              submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
              submitBtn.disabled = true;
              
              // Reset button after 3 seconds as fallback
              setTimeout(() => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
              }, 3000);
            }
          });
        });
        
        // Optimize listing clicks with minimal loading feedback
        const listingLinks = document.querySelectorAll('.listing-link');
        if (listingLinks.length > 0) {
          listingLinks.forEach(link => {
            if (link && typeof link.addEventListener === 'function') {
              link.addEventListener('click', function(e) {
                // Add subtle loading feedback
                const card = this.querySelector('.card');
                if (card) {
                  card.style.opacity = '0.7';
                  card.style.transition = 'opacity 0.2s ease';
                }
              });
            }
          });
        }
        
        // Optimize navigation
        const navLinks = document.querySelectorAll('a[href^="/"]');
        if (navLinks.length > 0) {
          navLinks.forEach(link => {
            if (link && typeof link.addEventListener === 'function') {
              link.addEventListener('click', function(e) {
                // Skip for forms and special links
                if (this.closest('form') || this.hasAttribute('data-no-loading')) {
                  return;
                }
                
                // Add minimal loading feedback
                this.style.opacity = '0.7';
                this.style.transition = 'opacity 0.2s ease';
              });
            }
          });
        }
      });
    </script>
  </body>
</html>
